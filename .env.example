# Local inference is the default: llama.cpp serves MiniCPM5-2B over HTTP.
LLM_MODEL=MiniCPM5-2B
MODEL_FILE=MiniCPM5-2B-Q4_K_M.gguf
N_CTX=6144
N_BATCH=512
# N_THREADS defaults to half of the logical CPUs
N_GPU_LAYERS=0
MAX_TOKENS=350

# llama.cpp server started by run.sh
LLAMA_SERVER_HOST=127.0.0.1
LLAMA_SERVER_PORT=5001
# Optional: path to a llama or llama-server binary if auto-detection fails
# LLAMA_SERVER_BIN=

# Brave Search is optional. DuckDuckGo works without a key.
BRAVE_API_KEY=

MAX_SOURCES=3
HTTP_TIMEOUT=10
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000
FLASK_DEBUG=0
