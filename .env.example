# Local inference is the default: llama.cpp runs MiniCPM5-2B in this process.
MODEL_FILE=MiniCPM5-2B-Q4_K_M.gguf
N_CTX=6144
N_BATCH=512
# N_THREADS defaults to half of the logical CPUs
N_GPU_LAYERS=0
MAX_TOKENS=350

# Brave Search is optional. DuckDuckGo works without a key.
BRAVE_API_KEY=

MAX_SOURCES=3
HTTP_TIMEOUT=10
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000
FLASK_DEBUG=0
