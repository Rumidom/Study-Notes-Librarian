# Local inference is the default: llama.cpp runs MiniCPM5-2B in this process.
MODEL_REPO=openbmb/MiniCPM5-2B-GGUF
MODEL_FILE=MiniCPM5-2B-Q4_K_M.gguf
MODEL_DIR=models
AUTO_DOWNLOAD=1
N_CTX=6144
# N_THREADS defaults to half of the logical CPUs
N_GPU_LAYERS=0
MAX_TOKENS=350

# Brave Search is optional. DuckDuckGo works without a key.
BRAVE_API_KEY=

# Local study cards are checked recursively before any web search.
STUDY_CARDS_DIR=study_cards

MAX_SOURCES=3
HTTP_TIMEOUT=10
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000
FLASK_DEBUG=0
